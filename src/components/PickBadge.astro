---
interface Props {
	/** Rendered size in px; the star scales with it */
	size?: number;
}

const { size = 22 } = Astro.props;
---

<span class="pick" title="Shared by midudev on X" style={`--size:${size}px`}>
	<svg viewBox="0 0 24 24" width={Math.round(size * 0.6)} height={Math.round(size * 0.6)} aria-hidden="true">
		<path
			fill="currentColor"
			d="M12 1.6l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8-6.1-3.4-6.1 3.4 1.4-6.8L2.2 8.7l6.9-.8z"
		></path>
	</svg>
	<span class="sr">Shared by midudev</span>
</span>

<style>
	.pick {
		display: grid;
		place-items: center;
		flex: none;
		width: var(--size);
		height: var(--size);
		border-radius: 999px;
		color: var(--star);
		background: color-mix(in srgb, var(--star) 14%, transparent);
	}

	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
