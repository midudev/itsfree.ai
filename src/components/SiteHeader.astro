---
interface Props {
	/** Route of the page rendering the header; that link is marked, not removed */
	current?: 'home' | 'models' | 'local';
}

const { current } = Astro.props;

const LINKS = [
	{ id: 'home', href: '/', label: 'resources' },
	{ id: 'models', href: '/models/', label: 'models' },
	{ id: 'local', href: '/?cat=local', label: 'local' }
];
---

<header class="top">
	<div class="wrap top-inner">
		<a class="brand" href="/">
			it's free<span class="star">*</span><span class="dot">.ai</span>
		</a>
		<nav class="nav">
			{
				LINKS.map((link) => (
					<a
						href={link.href}
						class:list={{ 'is-current': link.id === current }}
						aria-current={link.id === current ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
			<a href="https://x.com/midudev" target="_blank" rel="noopener noreferrer">@midudev</a>
		</nav>
	</div>
</header>

<style>
	.top {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.top-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.brand {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: -0.01em;
	}

	.brand .star {
		color: var(--star);
	}

	.brand .dot {
		color: var(--fg-faint);
	}

	.nav {
		display: flex;
		gap: 26px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-muted);
	}

	.nav a:hover {
		color: var(--fg);
	}

	/* You are already here, so the link is a label rather than a target */
	.nav .is-current {
		color: var(--star);
		pointer-events: none;
	}

	@media (max-width: 640px) {
		.nav {
			gap: 14px;
			font-size: 11.5px;
		}
	}

	@media (max-width: 400px) {
		.nav {
			gap: 10px;
			font-size: 11px;
		}
	}
</style>
