---
import Favicon from './Favicon.astro';
import { searchIndex, type Resource } from '../data/resources';
import { PROVIDERS } from '../data/providers';

interface Props {
	resources: Resource[];
}

const { resources } = Astro.props;

/** The one line that tells you how you actually start it */
function invocation(resource: Resource): string {
	const provider = PROVIDERS[resource.id];
	if (!provider) return resource.limits?.[0] ?? 'open source';
	if (provider.baseUrl.startsWith('http://localhost')) {
		return provider.baseUrl.replace('http://', '');
	}
	return provider.baseUrl;
}
---

<div class="grid">
	{
		resources.map((resource) => {
			const internal = Boolean(PROVIDERS[resource.id]);
			const href = internal ? `/provider/${resource.id}/` : resource.url;
			return (
				<article
					class="card"
					data-resource
					data-id={resource.id}
					data-category={resource.category}
					data-no-card={String(resource.noCard)}
					data-no-signup={String(Boolean(resource.noSignup))}
					data-openai={String(Boolean(resource.openaiCompatible))}
					data-pick={String(Boolean(resource.pick))}
					data-search={searchIndex(resource)}
				>
					<header class="head">
						<Favicon id={resource.id} size={24} alt={resource.name} />
						<h3 class="name">
							<a
								href={href}
								target={internal ? undefined : '_blank'}
								rel={internal ? undefined : 'noopener noreferrer'}
							>
								{resource.name}
								<span class="stretch" />
							</a>
						</h3>
						{resource.kind && <span class="kind">{resource.kind}</span>}
					</header>
					<p class="why">{resource.description}</p>
					<p class="cmd">{invocation(resource)}</p>
				</article>
			);
		})
	}
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 10px;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 9px;
		padding: 15px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-subtle);
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.card:hover {
		border-color: var(--border-strong);
		background: var(--bg-hover);
	}

	.head {
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.name {
		margin: 0;
		flex: 1;
		min-width: 0;
		font-size: 14.5px;
		font-weight: 550;
		letter-spacing: -0.02em;
	}

	.stretch {
		position: absolute;
		inset: 0;
	}

	.kind {
		flex: none;
		font-family: var(--font-mono);
		font-size: 9.5px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--fg-faint);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		padding: 2px 7px;
	}

	.why {
		margin: 0;
		font-size: 13px;
		line-height: 1.5;
		color: var(--fg-muted);
		/* Two lines everywhere keeps the command line aligned across the row */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 39px;
	}

	.cmd {
		margin: 0;
		padding-top: 8px;
		border-top: 1px solid #161616;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--fg-dim);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
