---
import icons from '../data/icons.json';

interface Props {
	/** Resource id (icons/) or vendor id (vendors/) */
	id: string;
	kind?: 'icons' | 'vendors';
	size?: number;
	alt?: string;
	/** Draw the tile behind the logo. Off for logos that sit on their own surface. */
	tile?: boolean;
	class?: string;
}

interface Entry {
	src: string;
	/** `light` marks a pale logo, which needs a dark tile to stay visible */
	tone: 'light' | 'dark';
}

const { id, kind = 'icons', size = 20, alt = '', tile = true, class: className } = Astro.props;
const entry = (icons as Record<string, Record<string, Entry>>)[kind][id];
---

<span
	class:list={['logo', { tile, missing: !entry, dark: entry?.tone === 'light' }, className]}
	style={`--size:${size}px`}
	aria-hidden={alt ? undefined : 'true'}
>
	{
		entry ? (
			<img src={entry.src} alt={alt} width={size} height={size} loading="lazy" decoding="async" />
		) : (
			id.charAt(0).toUpperCase()
		)
	}
</span>

<style>
	.logo {
		display: grid;
		place-items: center;
		flex: none;
		width: var(--size);
		height: var(--size);
		border-radius: calc(var(--size) * 0.26);
		overflow: hidden;
	}

	.logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* Plenty of logos are black on transparent and vanish in dark mode */
	.tile {
		background: #fff;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
		padding: calc(var(--size) * 0.12);
	}

	/* ...and pale logos vanish on white, so those get the opposite treatment */
	.tile.dark {
		background: #111;
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
	}

	.missing {
		background: var(--bg-hover);
		box-shadow: inset 0 0 0 1px var(--border);
		color: var(--fg-muted);
		font-family: var(--font-pixel);
		font-size: calc(var(--size) * 0.5);
		padding: 0;
	}
</style>
