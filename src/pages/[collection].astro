---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProviderTable from '../components/ProviderTable.astro';
import RuntimeGrid from '../components/RuntimeGrid.astro';
import ToolList from '../components/ToolList.astro';
import { COLLECTIONS, entriesOf, type Collection } from '../data/collections';
import { LAST_VERIFIED } from '../data/providers';
import { breadcrumbSchema, itemListSchema } from '../lib/seo';

export function getStaticPaths() {
	return COLLECTIONS.map((collection) => ({
		params: { collection: collection.slug },
		props: { collection }
	}));
}

interface Props {
	collection: Collection;
}

const { collection } = Astro.props;
const entries = entriesOf(collection);
const others = COLLECTIONS.filter((other) => other.slug !== collection.slug);

const path = (resource: (typeof entries)[number]) =>
	collection.layout === 'table' ? `/provider/${resource.id}/` : `/?cat=${resource.category}`;

const schemas = [
	breadcrumbSchema([
		{ name: 'Resources', path: '/' },
		{ name: collection.heading, path: `/${collection.slug}/` }
	]),
	itemListSchema(
		collection.heading,
		entries.map((resource) => ({ name: resource.name, path: path(resource) }))
	),
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: collection.faq.map((entry) => ({
			'@type': 'Question',
			name: entry.question,
			acceptedAnswer: { '@type': 'Answer', text: entry.answer }
		}))
	}
];
---

<Layout title={collection.title} description={collection.description} schemas={schemas}>
	<SiteHeader />

	<main class="wrap">
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/">Resources</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{collection.heading}</span>
		</nav>

		<header class="hero">
			<p class="eyebrow">{entries.length} options · verified {LAST_VERIFIED}</p>
			<h1>{collection.heading}</h1>
			{collection.intro.map((paragraph) => <p class="lede">{paragraph}</p>)}
		</header>

		<section class="block">
			{collection.layout === 'table' && <ProviderTable resources={entries} />}
			{collection.layout === 'grid' && <RuntimeGrid resources={entries} />}
			{collection.layout === 'list' && <ToolList resources={entries} />}
		</section>

		<section class="block">
			<h2>Questions about these</h2>
			<div class="faq">
				{
					collection.faq.map((entry) => (
						<div class="qa">
							<h3>{entry.question}</h3>
							<p>{entry.answer}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="block">
			<h2>Other ways to slice this</h2>
			<ul class="others">
				{
					others.map((other) => (
						<li>
							<a href={`/${other.slug}/`}>
								<span class="other-name">{other.heading}</span>
								<span class="other-count">{entriesOf(other).length}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	<SiteFooter mesh />
</Layout>

<style>
	main {
		padding-bottom: 56px;
	}

	.crumbs {
		display: flex;
		gap: 8px;
		padding-top: 28px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--fg-faint);
	}

	.crumbs a:hover {
		color: var(--fg);
	}

	.hero {
		padding: 26px 0 40px;
		max-width: 68ch;
	}

	.eyebrow {
		margin: 0 0 18px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--star);
	}

	h1 {
		margin: 0 0 20px;
		max-width: 18ch;
		font-size: clamp(32px, 5vw, 46px);
		line-height: 1.04;
		letter-spacing: -0.04em;
		font-weight: 600;
		text-wrap: balance;
	}

	.lede {
		margin: 0 0 14px;
		font-size: 16.5px;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	.lede:last-child {
		margin-bottom: 0;
	}

	.block {
		padding-block: 30px 12px;
		border-top: 1px solid var(--border);
	}

	.block:first-of-type {
		border-top: none;
		padding-top: 0;
	}

	h2 {
		margin: 0 0 16px;
		font-size: 21px;
		font-weight: 550;
		letter-spacing: -0.03em;
	}

	.faq {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
		gap: 0 44px;
	}

	.qa {
		padding: 18px 0;
		border-bottom: 1px solid #161616;
	}

	.qa h3 {
		margin: 0 0 8px;
		font-size: 14.5px;
		font-weight: 550;
		letter-spacing: -0.015em;
	}

	.qa p {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	.others {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.others a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 13px 14px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-subtle);
		font-size: 13.5px;
		transition:
			border-color 0.12s ease,
			background 0.12s ease;
	}

	.others a:hover {
		border-color: var(--border-strong);
		background: var(--bg-hover);
	}

	.other-name {
		flex: 1;
		min-width: 0;
	}

	.other-count {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--fg-faint);
	}
</style>
