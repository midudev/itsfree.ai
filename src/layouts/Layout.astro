---
import '../styles/global.css';
import {
	AUTHOR,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_TYPE,
	OG_IMAGE_WIDTH,
	SITE,
	SITE_NAME,
	canonicalUrl,
	fitDescription,
	fitTitle,
	ogImageUrl,
	shareImage,
	shareImageAlt
} from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	/** JSON-LD blocks for this page */
	schemas?: unknown[];
	/** Keep the page out of the index (404, thin variants). Links stay followable. */
	noindex?: boolean;
	/** Path of the next page in a series, if any */
	prev?: string;
	next?: string;
	/** Override the share card. Defaults to the PNG for this route. */
	image?: string;
	imageAlt?: string;
}

const {
	title = 'Free AI APIs and models — every free tier, compared',
	description =
		'Every way to use an AI model for free: rate limits, context windows and base URLs for 24 providers with a real free tier, plus 9 runtimes you can run yourself.',
	schemas = [],
	noindex = false,
	prev,
	next,
	image,
	imageAlt
} = Astro.props;

const pageTitle = fitTitle(title);
const pageDescription = fitDescription(description, {
	title: pageTitle,
	extra: 'Rate limits, context windows and base URLs, checked against each provider.'
});
const canonical = canonicalUrl(Astro.url.pathname);
const imagePath = image ?? shareImage(Astro.url.pathname);
const ogImage = ogImageUrl(imagePath);
const ogAlt = imageAlt ?? shareImageAlt(pageTitle, Astro.url.pathname);

const siteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_NAME,
	alternateName: 'itsfree.ai',
	url: SITE,
	description:
		'An open directory of every way to use an AI model without paying for it, with the limits re-checked against each provider.',
	inLanguage: 'en',
	potentialAction: {
		'@type': 'SearchAction',
		target: { '@type': 'EntryPoint', urlTemplate: `${SITE}/?q={search_term_string}` },
		'query-input': 'required name=search_term_string'
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#000000" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<meta
			name="robots"
			content={noindex
				? 'noindex, follow'
				: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		{prev && <link rel="prev" href={canonicalUrl(prev)} />}
		{next && <link rel="next" href={canonicalUrl(next)} />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content={OG_IMAGE_TYPE} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:alt" content={ogAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={AUTHOR} />
		<meta name="twitter:creator" content={AUTHOR} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogAlt} />

		<link
			rel="preload"
			href="/fonts/geist-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/geist-mono-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/geist-pixel-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />
		{
			schemas.map((schema) => (
				<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
			))
		}
	</head>
	<body>
		<slot />
	</body>
</html>
